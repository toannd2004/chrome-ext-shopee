# --- RCLONE MANAGER ---
# Generated by automake.sh
REMOTE_PATH = gdrivenetb:Projects/05.NetB/Timn/Ext-Shopee
LOCAL_PATH  = .
TIMESTAMP   = $(shell date +%Y%m%d_%H%M%S)

# --- XỬ LÝ CHẾ ĐỘ (SYNC vs COPY) ---
ifneq ($(filter copy,$(MAKECMDGOALS)),)
	MODE_NAME = COPY (Chỉ Update - KHÔNG XÓA)
	RCLONE_CMD = rclone copy
	COLOR = $(CYAN)
else
	MODE_NAME = SYNC (Mirror - CÓ XÓA FILE THỪA)
	RCLONE_CMD = rclone sync
	COLOR = $(RED)
endif

# --- CẤU HÌNH BACKUP ---
BACKUP_PUSH = --backup-dir "$(REMOTE_PATH)_Trash/$(TIMESTAMP)"
SUFFIX_PULL = --suffix ".bak_$(TIMESTAMP)" --suffix-keep-extension

# --- BỘ LỌC FILE (EXCLUDES) ---
EXCLUDES = --exclude ".git/**"            --exclude ".DS_Store"            --exclude "Makefile"            --exclude "**/.idea/**"            --exclude "**/.vscode/**"            --exclude "venv/**"            --exclude "**/venv/**"            --exclude "**/.venv/**"            --exclude "**/node_modules/**"            --exclude "build/**"            --exclude "**/build/**"            --exclude "**/.build*/**"            --exclude "dist/**"            --exclude "**/dist/**"            --exclude "**/.env"            --exclude "**/__pycache__/**"            --exclude "._*"            --exclude "**/._*"            --exclude "*.bak_*"

FLAGS = --progress --human-readable --create-empty-src-dirs $(EXCLUDES)

# Màu sắc
GREEN  := $(shell tput -Txterm setaf 2)
YELLOW := $(shell tput -Txterm setaf 3)
RED    := $(shell tput -Txterm setaf 1)
CYAN   := $(shell tput -Txterm setaf 6)
NC     := $(shell tput -Txterm sgr0)

.PHONY: help config status push pull copy clean

help:
	@echo "${YELLOW}--- Sync Manager ---${NC}"
	@echo "Remote: ${GREEN}$(REMOTE_PATH)${NC}"
	@echo "--------------------"
	@echo "  make status    : Check thay đổi (Dry-run)"
	@echo "  make push      : SYNC lên Cloud"
	@echo "  make pull      : SYNC về Máy"
	@echo "  make copy push : COPY lên Cloud (An toàn)"
	@echo "  make clean     : Dọn dẹp rác"

copy:
	@echo "${CYAN}🛡️  Chế độ COPY (An toàn)...${NC}"

config:
	@echo "Remote Path: $(REMOTE_PATH)"

status:
	@echo "${YELLOW}🔍 Đang kiểm tra thay đổi...${NC}"
	@rclone check "$(LOCAL_PATH)" "$(REMOTE_PATH)" $(EXCLUDES) --one-way || true
	@date "+🕒 Thời gian lúc này: %d-%m-%Y %H:%M:%S"

push:
	@echo "${COLOR}🚀 [$(MODE_NAME)] Uploading...${NC}"
	@$(RCLONE_CMD) "$(LOCAL_PATH)" "$(REMOTE_PATH)" $(FLAGS) $(BACKUP_PUSH) --log-file=.rclone.log --log-level INFO
	@echo "${CYAN}📄 Danh sách file đã xử lý:${NC}"
	@if grep -qE "Copied|Deleted|Moved" .rclone.log 2>/dev/null; then 	  grep -E "Copied|Deleted|Moved" .rclone.log | sed 's/.*INFO *: /  - /'; 	else 	  echo "  (Không có file nào thay đổi)"; 	fi
	@rm -f .rclone.log
	@date "+🕒 Thời gian thực hiện: %d-%m-%Y %H:%M:%S"
	@echo "${GREEN}✅ Hoàn tất!${NC}"

pull:
	@echo "${COLOR}⬇️  [$(MODE_NAME)] Downloading...${NC}"
	@$(RCLONE_CMD) "$(REMOTE_PATH)" "$(LOCAL_PATH)" $(FLAGS) $(SUFFIX_PULL) --log-file=.rclone.log --log-level INFO
	@echo "${CYAN}📄 Danh sách file đã xử lý:${NC}"
	@if grep -qE "Copied|Deleted|Moved" .rclone.log 2>/dev/null; then 	  grep -E "Copied|Deleted|Moved" .rclone.log | sed 's/.*INFO *: /  - /'; 	else 	  echo "  (Không có file nào thay đổi)"; 	fi
	@rm -f .rclone.log
	@date "+🕒 Thời gian thực hiện: %d-%m-%Y %H:%M:%S"
	@echo "${GREEN}✅ Hoàn tất!${NC}"

clean:
	@echo "${RED}🗑️  Dọn dẹp rác...${NC}"
	@find . -type f -name "*.bak_*" -delete
	@find . -type f -name "._*" -delete
	@date "+🕒 Thời gian thực hiện: %d-%m-%Y %H:%M:%S"
	@echo "${GREEN}✅ Sạch bóng!${NC}"
